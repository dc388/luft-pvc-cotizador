{
  "name": "luft-pvc-cotizador",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/costeo.test.mjs",
    "test:unit": "node --import ./tests/register-ts-loader.mjs --test tests/assistantBrief.test.ts tests/availability.test.ts tests/briefMatch.test.ts tests/public-assistant.test.ts tests/publicSteps.test.ts tests/quoteRepo.test.ts tests/hardware.test.ts tests/projectFile.test.ts tests/learning.test.ts tests/requester.test.ts",
    "test:agents": "node scripts/test-luft-ai.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:migrate:local": "bash scripts/sites-env.sh -- wrangler d1 migrations apply DB --local",
    "maco:import:dry": "node --import ./tests/register-ts-loader.mjs scripts/import-maco.ts --dry-run --file=\"C:/Users/jsald/AppData/Roaming/Microsoft/Office/Recent/LOUDVENTURES_MEXpricelist22_2022_MACO.LNK\"",
    "maco:import": "node --import ./tests/register-ts-loader.mjs scripts/import-maco.ts --file=\"C:/Users/jsald/AppData/Roaming/Microsoft/Office/Recent/LOUDVENTURES_MEXpricelist22_2022_MACO.LNK\"",
    "test:maco": "node --import ./tests/register-ts-loader.mjs --test tests/macoDecimal.test.ts tests/macoPriceList.test.ts tests/macoImport.test.ts tests/macoCatalog.test.ts tests/macoCosting.test.ts",
    "test:costeo": "node --test tests/costeo.test.mjs"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Luft PVC Cotizador",
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.0": true,
    "esbuild@0.27.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260515.1": true
  }
}
